# ===========================================================================
#  Tunnel head configuration (public server)
#
#  Copy to .env and edit:   cp .env.example .env
# ===========================================================================

# Shared secret. MUST match TUNNEL_TOKEN in the Kingdom's .env on the local
# machine. Anything that connects with this token gets to answer requests on
# behalf of your local services, so treat it as a production credential.
#
# Generate one:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Empty means the head refuses every client — it fails closed, not open.
TUNNEL_TOKEN=

# --- Public listener: the token-authenticated agent endpoint ----------------
# This is the port the local machine dials in to. Expose it to the internet.
TUNNEL_PUBLIC_PORT=9000
TUNNEL_PUBLIC_BIND=0.0.0.0

# --- Local listener: the forwarding surface --------------------------------
# UNAUTHENTICATED BY DESIGN — the chatbot's embedding client cannot send a
# credential. FIREWALL THIS PORT so only your own containers reach it.
# 0.0.0.0 is required for Docker containers to reach it via
# host.docker.internal; narrow it to the docker bridge IP if you can.
TUNNEL_LOCAL_PORT=9001
TUNNEL_LOCAL_BIND=0.0.0.0

# --- Fallback ---------------------------------------------------------------
# Where to send traffic when the tunnel cannot serve it. Without this, requests
# get a 503 the whole time the local machine is offline.
#
# Format:  /prefix=url,/prefix2=url2      (longest matching prefix wins)
# Example: a CPU Ollama on this server standing in for the GPU box
#     TUNNEL_FALLBACKS=/ollama=http://127.0.0.1:11434
#
# NOTE for Git Bash on Windows: values starting with "/" get rewritten by MSYS
# path conversion. run.sh sets MSYS2_ENV_CONV_EXCL to prevent it; if you launch
# server.py by hand there, use cmd instead.
TUNNEL_FALLBACKS=

# Fail over on timeout / client error too, not only on a fully absent client.
# Timeouts wait TUNNEL_FIRST_BYTE_TIMEOUT before failing over, so this trades
# worst-case latency for availability.
TUNNEL_FALLBACK_ON_ERROR=true

# Strip the route prefix before calling the fallback: /ollama/api/tags arrives
# as /api/tags. Correct when the fallback points straight at a backend, which
# is the usual case. Turn off if the fallback expects the prefix.
TUNNEL_FALLBACK_STRIP_PREFIX=true

TUNNEL_FALLBACK_READ_TIMEOUT=600

# --- Timeouts --------------------------------------------------------------
# Wait for the response head. A cold 14B model load measured ~20s to first
# token, so leave headroom.
TUNNEL_FIRST_BYTE_TIMEOUT=120
# Max gap between body chunks once streaming has started.
TUNNEL_IDLE_TIMEOUT=300
# Wait for the far end to report a tunnelled WebSocket actually opened.
TUNNEL_WS_OPEN_TIMEOUT=30

# Max request body the head will accept, in bytes (default 1GB). Note that
# bodies are buffered whole — see "Limits" in README.md.
# TUNNEL_MAX_CONTENT_LENGTH=1073741824
