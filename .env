# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
LOG_LEVEL=DEBUG
SECRET_KEY=your-secret-key-here

# Server
HOST='0.0.0.0'
PORT=2000

# Backend Services
APP1_URLS=http://127.0.0.1:3000
APP2_URLS=http://127.0.0.1:5000
API_URL=http://127.0.0.1:2000

# Multiple backend URLs (new - comma-separated)
# APP1_URLS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
# APP2_URLS=http://127.0.0.1:5000,http://127.0.0.1:5001
# API_URLS=http://127.0.0.1:7000 # Keep API as single instance

# Load balancing configuration
LOAD_BALANCER_STRATEGY=round_robin
# Options: round_robin, random, least_connections, weighted

# Health check thresholds
UNHEALTHY_THRESHOLD=3
RECOVERY_THRESHOLD=2

# Configuration store
# Routes and backends live in MongoDB, not here, so that anything added through
# the admin panel survives a restart. The values below are only a fallback and
# a first-run seed: on an empty collection they are copied into the database
# once, and from then on the database is the source of truth.
#
# If Mongo is unreachable the proxy still starts and uses the routes below -
# degraded, not down. Check /admin/config/source to see which is in effect.
PROXY_MONGO_URL=mongodb://192.168.12.8:27018/poxy-management
# PROXY_MONGO_DB=            # only needed if the URL has no database in it
PROXY_MONGO_COLLECTION=backends
PROXY_MONGO_TIMEOUT_MS=3000

# API Key Authentication
API_KEY_HEADER=X-API-Key
API_KEY_PREFIX=pk_
API_KEY_LENGTH=32
MASTER_API_KEY=ByHpnnvsRx6mbshODx9d1f9RCa2dFk7vcb1xJzlL61M

# CORS
CORS_ORIGINS=*

# Rate Limiting
# 100/3600 is a refill rate: one request every 36s after the opening burst.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
# /ollama is exempt: its callers cannot send an API key, so the whole chatbot
# platform shared one IP-keyed bucket and got one embed per 36s.
RATE_LIMIT_EXEMPT_ROUTES=/ollama

# Monitoring
HEALTH_CHECK_INTERVAL=30
REQUEST_TIMEOUT=90
MAX_CONTENT_LENGTH=16777216
HEALTH_CHECK_CONNECT_TIMEOUT=5
HEALTH_CHECK_READ_TIMEOUT=30
HEALTH_CHECK_TOTAL_TIMEOUT=35

# Load Balancing
LOAD_BALANCER_STRATEGY=round_robin
BACKEND_HEALTH_CHECK=True
UNHEALTHY_THRESHOLD=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=proxy.log

# ✅ FIXED WebSocket Configuration
SOCKETIO_CORS_ENABLED=True
SOCKETIO_CORS_ORIGINS=*
CLIENT_IDLE_TIMEOUT_SECONDS=300
BACKEND_SOCKET_TIMEOUT_SECONDS=300
WS_BACKEND_CONNECT_TIMEOUT=30
WS_PING_INTERVAL=20
WS_MAX_MESSAGE_SIZE=16777216

# Synchronous WebSocket Configuration
WS_SYNC_BACKEND_TIMEOUT=30
WS_READINESS_CHECK_TIMEOUT=5

# Add this to force UTF-8 encoding on Windows
PYTHONIOENCODING=utf-8
