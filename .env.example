# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Backend Services
APP1_URL=http://localhost:3000
APP2_URL=http://localhost:5000
API_URL=http://localhost:7000

# Local Ollama, published through the proxy like any other backend
OLLAMA_URLS=http://127.0.0.1:11434
# Routes whose responses must be relayed chunk-by-chunk instead of buffered
STREAMING_ROUTES=/ollama
STREAMING_READ_TIMEOUT=600

# Frontend (FrontEnd/Proxy-Management) ports, used by start.bat / run.sh.
# Both are passed to the child processes explicitly, so whatever you set
# here is what actually gets bound and what the launcher reports.
# NOTE: PORT above belongs to the PROXY. The admin API needs its own,
# because it would otherwise inherit PORT and collide with the proxy.
FRONTEND_API_PORT=5050
FRONTEND_UI_PORT=5173

# Outbound Tunnel (self-hosted ngrok — see tunnel_server/README.md)
# Leave TUNNEL_SERVER_URL empty for a normal local-only run.
# The token must match TUNNEL_TOKEN on the tunnel head.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TUNNEL_SERVER_URL=
TUNNEL_TOKEN=
TUNNEL_LOCAL_TARGET=http://127.0.0.1:2000
TUNNEL_CLIENT_NAME=

# Configuration store
# Routes and backends live in MongoDB, not here, so that anything added through
# the admin panel survives a restart. The values below are only a fallback and
# a first-run seed: on an empty collection they are copied into the database
# once, and from then on the database is the source of truth.
#
# If Mongo is unreachable the proxy still starts and uses the routes below -
# degraded, not down. Check /admin/config/source to see which is in effect.
PROXY_MONGO_URL=mongodb://192.168.12.8:27018/poxy-management
# PROXY_MONGO_DB=            # only needed if the URL has no database in it
PROXY_MONGO_COLLECTION=backends
PROXY_MONGO_TIMEOUT_MS=3000

# API Key Authentication
API_KEY_HEADER=X-API-Key
API_KEY_PREFIX=pk_
API_KEY_LENGTH=32

# The master key. It unlocks every admin write endpoint (add/remove backends,
# mint and revoke API keys) and is what you sign in to the management UI with.
#
# GENERATE YOUR OWN - do not ship a value copied from this file:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Left empty deliberately. An empty master key means no master key exists, so
# admin writes are refused until you set one. That is the safe failure: a
# placeholder value here would be a working, publicly known credential.
MASTER_API_KEY=

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring
HEALTH_CHECK_INTERVAL=30
REQUEST_TIMEOUT=30
MAX_CONTENT_LENGTH=16777216

# Load Balancing
LOAD_BALANCER_STRATEGY=round_robin
BACKEND_HEALTH_CHECK=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=proxy.log
